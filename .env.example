# 32-byte base64 key that encrypts the recoverable parent passwords (Super Admin "Show password").
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must be identical on every deployment that shares the database; losing it makes stored passwords unreadable.
CREDENTIAL_ENCRYPTION_KEY=
